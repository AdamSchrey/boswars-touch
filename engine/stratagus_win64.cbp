	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="boswars" />
		<Option pch_mode="2" />
		<Option default_target="Release" />
		<Option compiler="msys2_gcc_compiler_64bit" />
		<Build>
			<Target title="Debug">
				<Option output="./Debug/boswars" prefix_auto="1" extension_auto="1" />
				<Option object_output="Debug" />
				<Option type="0" />
				<Option compiler="msys2_gcc_compiler_64bit" />
				<Option parameters='-d &quot;D:/boswars_win64&quot;' />
				<Compiler>
					<Add option="-g" />
					<Add option="-W" />
					<Add option="-O0" />
					<Add option="-DUSE_VORBIS" />
					<Add option="-DUSE_THEORA" />
					<Add option="-DHAVE_STRNLEN" />
					<Add option="-D_DEBUG" />
					<Add option="-DDEBUG" />
					<Add directory="../include" />
					<Add directory="include" />
					<Add directory="guichan/include" />
					<Add directory="src" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="../include" />
					<Add directory="include" />
					<Add directory="guichan/include" />
				</ResourceCompiler>
				<Linker>
					<Add directory="../lib" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="./Release/boswars" prefix_auto="1" extension_auto="1" />
				<Option object_output="Release" />
				<Option type="0" />
				<Option compiler="msys2_gcc_compiler_64bit" />
				<Option parameters='-d &quot;D:/boswars_win64&quot;' />
				<Compiler>
					<Add option="-Os" />
					<Add option="-W" />
					<Add option="-DUSE_VORBIS" />
					<Add option="-DUSE_THEORA" />
					<Add option="-DHAVE_STRNLEN" />
					<Add option="-DNDEBUG" />
					<Add directory="../include" />
					<Add directory="include" />
					<Add directory="guichan/include" />
					<Add directory="src" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="../include" />
					<Add directory="include" />
					<Add directory="guichan/include" />
				</ResourceCompiler>
				<Linker>
					<Add option="-s" />
					<Add directory="../lib" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c++98" />
