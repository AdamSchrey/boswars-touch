{
  "clickable_minimum_required": "8.8.0",
  "kill": "boswars-touch",
  "builder": "make",
  "framework": "@CLICK_FRAMEWORK@",
  "build_args": "",
  "build_dir": "${ROOT}/build/${ARCH_TRIPLET}/app",
  "dependencies_target": [
		"libsdl2-2.0-0",
		"liblua5.1-0",
		"libpng16-16",
		"libvorbis0a",
		"libtheora0",
		"libogg0",
		"zlib1g"
  ],
  "install_lib": [
         "${ROOT}/lib/${ARCH_TRIPLET}/*"
  ],
  "install_data": {
    "${ROOT}/data/*": "${INSTALL_DIR}",
    "${ROOT}/build/${ARCH_TRIPLET}/app/boswars": "${INSTALL_DIR}"
  },
  "premake": "bash ${ROOT}/make_project.sh",
  "postmake": "bash ${ROOT}/import_binaries.sh"
}
